# TLS certificates come from Let's Encrypt once SIGHTGLASS_DOMAIN's DNS points at this host.
{$SIGHTGLASS_DOMAIN} {
	encode zstd gzip

	# A demo for a few testers can sit behind a password. Generate the hash with:
	#   docker compose run --rm caddy caddy hash-password
	# basic_auth {
	# 	tester <hash>
	# }

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
