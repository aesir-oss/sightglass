# Copy to deploy/.env (ignored by git) and fill in. docker compose reads it from this directory.

# Public hostname; its DNS A record must point at the VM before Caddy can get a certificate.
SIGHTGLASS_DOMAIN=sightglass.example.com

# Supabase: Connect -> Session pooler (port 5432). Never the transaction pooler on 6543: the job queue needs
# LISTEN/NOTIFY and session locks. From postgresql://<user>:<password>@<host>:5432/<name>:
SIGHTGLASS_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SIGHTGLASS_DB_PORT=5432
SIGHTGLASS_DB_USER=postgres.your-project-ref
# URL-encode any characters outside letters, digits and -._~ (for example @ becomes %40). Avoid spaces: the
# worker's connection string drops their encoding.
SIGHTGLASS_DB_PASSWORD=
SIGHTGLASS_DB_NAME=postgres
SIGHTGLASS_DB_SSLMODE=require
